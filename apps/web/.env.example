# Backend API base URL (admin surface). Must match the backend PORT.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/admin/v1

# Public URL of the site — canonical links, sitemap and social cards on the landing page.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Where /demo and the "Book a demo" dialog POST requests (JSON). Leave empty until it exists —
# the form then tells visitors online booking isn't connected (it never fakes success).
NEXT_PUBLIC_DEMO_ENDPOINT=
