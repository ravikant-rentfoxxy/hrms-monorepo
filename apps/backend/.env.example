NODE_ENV=development
PORT=4000

# PostgreSQL (docker-compose maps container 5432 -> host 5433)
DATABASE_URL=postgresql://hrms:hrms_secret_pw@localhost:5433/hrms?schema=public

# JWT — use long random strings in production (openssl rand -hex 32)
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars!!
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars!
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# MinIO (S3-compatible object storage for files of any format)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=hrms_minio
MINIO_SECRET_KEY=hrms_minio_secret
MINIO_BUCKET=hrms-files

# Bootstrap super admin (created/updated by `npm run db:seed`)
SUPERADMIN_EMAIL=superadmin@hrms.local
SUPERADMIN_PASSWORD=SuperAdmin@123

# Comma-separated allowed origins, or * for all
CORS_ORIGINS=*

# Max upload size in MB
MAX_UPLOAD_MB=15

# Encryption key for PAN / Aadhaar / bank account / UAN at rest (openssl rand -hex 32).
# Optional — falls back to a key derived from JWT_ACCESS_SECRET. Never change it once data exists.
FIELD_ENCRYPTION_KEY=

# Public web portal URL, used in candidate-portal links
WEB_PUBLIC_URL=http://localhost:3000

# Set to false to disable the background job scheduler (e.g. on extra API replicas)
SCHEDULER_ENABLED=true
