NODE_ENV=development
PORT=4000

# PostgreSQL (docker-compose maps container 5432 -> host 5433)
DATABASE_URL=postgresql://hrms:hrms_secret_pw@localhost:5433/hrms?schema=public

# JWT — use long random strings in production (openssl rand -hex 32)
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars!!
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars!
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# MinIO (S3-compatible object storage for files of any format)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=hrms_minio
MINIO_SECRET_KEY=hrms_minio_secret
MINIO_BUCKET=hrms-files
# Address browsers and the mobile app use to open file links. Empty = MINIO_ENDPOINT (this computer only).
# Phone on the same Wi-Fi: http://<this computer's LAN IP>:9000 · Production: https://files.yourdomain.com
MINIO_PUBLIC_URL=

# Bootstrap super admin (created/updated by `npm run db:seed`)
SUPERADMIN_EMAIL=superadmin@hrms.local
SUPERADMIN_PASSWORD=SuperAdmin@123

# Comma-separated allowed origins, or * for all
CORS_ORIGINS=*

# Max upload size in MB
MAX_UPLOAD_MB=15

# Encryption key for PAN / Aadhaar / bank account / UAN at rest (openssl rand -hex 32).
# Optional — falls back to a key derived from JWT_ACCESS_SECRET. Never change it once data exists.
FIELD_ENCRYPTION_KEY=

# Public web portal URL, used in candidate-portal links
WEB_PUBLIC_URL=http://localhost:3000

# Set to false to disable the background job scheduler (e.g. on extra API replicas)
SCHEDULER_ENABLED=true

# Outgoing email (e.g. sending payslips) over SMTP. Leave SMTP_HOST empty to keep email off.
# Gmail / Google Workspace: smtp.gmail.com / 587 / an app password · Microsoft 365: smtp.office365.com / 587
SMTP_HOST=
SMTP_PORT=587
# true for port 465 (SSL), false for 587 (STARTTLS)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Sender shown to employees, e.g. "Rentfoxxy HR <hr@rentfoxxy.com>"
MAIL_FROM=
